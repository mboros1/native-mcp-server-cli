{
  "compilerOptions": {
    "checkJs": true,
    "moduleResolution": "node",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": false,
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["./lib/*"],
      "@agents/*": ["./lib/agents/*"],
      "@jsonrpc/*": ["./lib/jsonrpc/*"],
      "@tools/*": ["./tools/*"]
    }
  },
  "include": [
    "**/*.js",
    "**/*.mjs",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "test/**/*"
  ]
}