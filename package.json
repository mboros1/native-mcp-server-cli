{
  "name": "@native/mcp-cli",
  "version": "0.1.0",
  "description": "Native MCP Server CLI with high-performance terminal UI",
  "main": "./lib/index.js",
  "type": "module",
  "bin": {
    "mcp-cli": "./cli.js"
  },
  "scripts": {
    "start": "node cli.js",
    "dev": "node --watch cli.js",
    "build": "make -C src",
    "clean": "make -C src clean",
    "test": "./scripts/run_tests.sh",
    "test:js": "./scripts/run_js_tests.sh",
    "test:all": "./scripts/run_tests.sh && ./scripts/run_js_tests.sh"
  },
  "files": [
    "lib/",
    "src/",
    "server/",
    "deps/",
    "cli.js",
    "README.md"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.57.0",
    "@modelcontextprotocol/sdk": "^1.17.1",
    "axios": "^1.11.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^17.2.1",
    "fast-glob": "^3.3.3",
    "node-fetch": "^3.3.2",
    "node-pty": "^1.0.0",
    "winston": "^3.11.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "cli",
    "terminal",
    "assistant",
    "native"
  ],
  "author": "Your Name",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/native-mcp-cli.git"
  }
}
